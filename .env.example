# Use the project URL and public publishable key from the Supabase Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are also supported if your project uses them.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Required by Settings when creating team accounts.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Gemini BOM extraction is enabled only when explicitly configured.
GEMINI_API_KEY=
BOM_GEMINI_MODEL=gemini-3-flash-preview
BOM_EXTRACTION_PROVIDER=manual

# Developer security. Never enable a live wipe before independent-backup setup and drills.
DEVELOPER_APP_ORIGIN=https://mapel-job-tracker.vercel.app
KILL_SWITCH_ENABLED=false

# Enable only after configuring a phone OTP provider in Supabase.
NEXT_PUBLIC_PHONE_OTP_ENABLED=false
