# Use the project URL and public publishable key from the Supabase Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are also supported if your project uses them.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Required by Settings when creating team accounts.
SUPABASE_SERVICE_ROLE_KEY=

# Enable only after configuring a phone OTP provider in Supabase.
NEXT_PUBLIC_PHONE_OTP_ENABLED=false
